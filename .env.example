# Fastify listens on loopback behind nginx in the deployed topology.
HOST=127.0.0.1
PORT=7077

# Required provider and admin credentials. Leave blank until real secrets exist.
OPENAI_API_KEY=
ADMIN_API_TOKEN=
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional bootstrap/test tokens. Managed clients use CLIENT_KEYS_FILE instead.
# For non-root local development, point CLIENT_KEYS_FILE at a writable tmp path.
SPEECH_TO_TEXT_API_KEYS=
CLIENT_KEYS_FILE=/var/lib/speech-to-text/client-keys.json

# The file limit is 25 MiB; nginx allows 26 MiB for multipart overhead.
MAX_AUDIO_BYTES=26214400
REQUEST_TIMEOUT_MS=120000
LOG_TRANSCRIPTS=false
